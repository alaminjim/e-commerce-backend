enum CollectionStatus {
  ACTIVE
  INACTIVE
}

model Collection {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  status      CollectionStatus @default(ACTIVE)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([sortOrder])
}
