# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/omers?schema=public"

# Client origin (Next.js frontend)
CLIENT_URL=http://localhost:3000

# JWT secrets (used by authentication later)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Better Auth (authentication)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000/api/v1/auth

# Google OAuth (social login) — get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Facebook OAuth (social login) — get these from https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=replace-with-your-facebook-app-id
FACEBOOK_CLIENT_SECRET=replace-with-your-facebook-app-secret
